generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique
  price       Decimal  @db.Decimal(8, 2)
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
