APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=ecommerce
APP_DB_HOST=localhost
APP_DB_PORT=5432

# PostgreSQL Docker image initialization. Keep these aligned with APP_DB_*.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=1h

REDIS_URL=redis://localhost:6379
# Cache-manager TTL values are milliseconds.
CART_CACHE_TTL=60000

# RabbitMQ
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=ecommerce
RABBITMQ_URL=amqp://ecommerce:ecommerce@localhost:5672
# Legacy single-queue setting; retained for parity with existing environments.
RABBITMQ_QUEUE=payment
RABBITMQ_PROCESS_QUEUE=payment-process
RABBITMQ_RETRY_QUEUE=payment-retry
